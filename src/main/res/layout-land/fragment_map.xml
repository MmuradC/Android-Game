<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The Fool's Journey"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mapSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose the next Major Arcana on the path."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/mapPathPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_background"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/combatNodeButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/ui_button_plain"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="I - The Magician"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="10dp"
                    android:background="@color/tarot_gold" />

                <TextView
                    android:id="@+id/mapNodeTower"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/panel_background"
                    android:gravity="center"
                    android:text="XVI - The Tower"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="10dp"
                    android:background="@color/tarot_gold" />

                <TextView
                    android:id="@+id/mapNodeDeath"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/panel_background"
                    android:gravity="center"
                    android:text="XIII - Death"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="10dp"
                    android:background="@color/tarot_gold" />

                <TextView
                    android:id="@+id/mapNodeDevil"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/panel_background"
                    android:gravity="center"
                    android:text="XV - The Devil"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="10dp"
                    android:background="@color/tarot_gold" />

                <TextView
                    android:id="@+id/mapNodeHermit"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/panel_background"
                    android:gravity="center"
                    android:text="IX - The Hermit"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="10dp"
                    android:background="@color/tarot_gold" />

                <TextView
                    android:id="@+id/mapNodeWorld"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/panel_background"
                    android:gravity="center"
                    android:text="XXI - The World"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/codexButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/ui_button_plain"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Open Codex"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/deckButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/ui_button_plain"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Deck"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quitRunButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/ui_button_danger"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Quit Run"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
