<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_space"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="The Fool's Journey"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mapSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Choose the next Major Arcana on the path."
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mapPathPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/combatNodeButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/ui_button_plain"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="I - The Magician"
                android:textColor="@color/black"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="@color/tarot_gold" />

            <TextView
                android:id="@+id/mapNodeTower"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/panel_background"
                android:gravity="center"
                android:text="XVI - The Tower"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="@color/tarot_gold" />

            <TextView
                android:id="@+id/mapNodeDeath"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/panel_background"
                android:gravity="center"
                android:text="XIII - Death"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="@color/tarot_gold" />

            <TextView
                android:id="@+id/mapNodeDevil"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/panel_background"
                android:gravity="center"
                android:text="XV - The Devil"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="@color/tarot_gold" />

            <TextView
                android:id="@+id/mapNodeHermit"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/panel_background"
                android:gravity="center"
                android:text="IX - The Hermit"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="@color/tarot_gold" />

            <TextView
                android:id="@+id/mapNodeWorld"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/panel_background"
                android:gravity="center"
                android:text="XXI - The World"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/codexButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/ui_button_plain"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Open Codex"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/deckButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ui_button_plain"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Deck"
        android:textColor="@color/black"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quitRunButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ui_button_danger"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Quit Run"
        android:textColor="@color/black"
        android:textStyle="bold" />
</LinearLayout>
